<?xml version="1.0"?>
<robot name="throwbot">

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.11" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="0.40 0.30 0.12"/></geometry>
      <material name="base_gray"><color rgba="0.6 0.6 0.6 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="0.40 0.30 0.12"/></geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.0435" ixy="0" ixz="0" iyy="0.0727" iyz="0" izz="0.1042"/>
    </inertial>
  </link>

  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      <material name="wheel_black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.000379" ixy="0" ixz="0" iyy="0.000379" iyz="0" izz="0.000625"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.18 -0.06" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      <material name="wheel_black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.000379" ixy="0" ixz="0" iyy="0.000379" iyz="0" izz="0.000625"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.18 -0.06" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="caster_wheel_link">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
      <material name="caster_black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.000125" ixy="0" ixz="0" iyy="0.000125" iyz="0" izz="0.000125"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel_link"/>
    <origin xyz="0.15 0 -0.085"/>
  </joint>

  <link name="arm_mount">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.05"/></geometry>
      <material name="mount_gray"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.000154" ixy="0" ixz="0" iyy="0.000154" iyz="0" izz="0.000184"/>
    </inertial>
  </link>

  <joint name="arm_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_mount"/>
    <origin xyz="0 0 0.085"/>
  </joint>

  <link name="waist_link">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.03"/></geometry>
      <material name="waist_black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000072" ixy="0" ixz="0" iyy="0.000072" iyz="0" izz="0.000072"/>
    </inertial>
  </link>

  <joint name="waist_joint" type="revolute">
    <parent link="arm_mount"/>
    <child link="waist_link"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.79" upper="2.79" effort="10" velocity="1.5"/>
  </joint>

  <link name="upper_arm_link">
    <visual>
      <origin xyz="0 0 0.1"/>
      <geometry><cylinder radius="0.02" length="0.2"/></geometry>
      <material name="upper_arm_grey"><color rgba="0.6 0.6 0.6 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.1"/>
      <geometry><cylinder radius="0.02" length="0.2"/></geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.000515" ixy="0" ixz="0" iyy="0.000515" iyz="0" izz="0.00003"/>
    </inertial>
  </link>

  <joint name="shoulder_joint" type="revolute">
    <parent link="waist_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.5"/>
  </joint>

  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 0.09"/>
      <geometry><cylinder radius="0.015" length="0.18"/></geometry>
      <material name="forearm_grey"><color rgba="0.6 0.6 0.6 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.09"/>
      <geometry><cylinder radius="0.015" length="0.18"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.000276" ixy="0" ixz="0" iyy="0.000276" iyz="0" izz="0.0000113"/>
    </inertial>
  </link>

  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.30" upper="2.30" effort="10" velocity="1.5"/>
  </joint>

  <link name="tool_frame">
    <visual>
      <geometry><box size="0.03 0.03 0.03"/></geometry>
      <material name="tool_teal"><color rgba="0.1 0.55 0.5 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="0.03 0.03 0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0000075" ixy="0" ixz="0" iyy="0.0000075" iyz="0" izz="0.0000075"/>
    </inertial>
  </link>

  <joint name="tool_frame_joint" type="fixed">
    <parent link="forearm_link"/>
    <child link="tool_frame"/>
    <origin xyz="0 0 0.18" rpy="0 0 0"/>
  </joint>

</robot>